# ============================================
# Platform AI Solutions -- Environment Variables
# ============================================
# Copy this file: cp .env.example .env
# Fill in all REQUIRED values before starting.
#
# Variables marked REQUIRED must be set before the service boots.
# Variables marked OPTIONAL have safe defaults or enable non-critical features.

# ----------------------------------------
# Environment
# ----------------------------------------

# OPTIONAL - Set to "production" to enable strict secret validation at startup
ENVIRONMENT=development

# ----------------------------------------
# Core / Shared
# ----------------------------------------

# REQUIRED - Secret key for JWT signing (min 32 chars in production)
SECRET_KEY=changeme_in_production_please_32chars

# REQUIRED - Fernet encryption key for credential encryption at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# REQUIRED - Internal API token for service-to-service authentication
INTERNAL_API_TOKEN=change-me-to-a-random-string

# NOTE: INTERNAL_SECRET_KEY is a legacy alias for INTERNAL_API_TOKEN.
# whatsapp_service and meta_service still read INTERNAL_SECRET_KEY directly.
# Set both to the same value until all services are migrated.
INTERNAL_SECRET_KEY=change-me-to-a-random-string

# REQUIRED - Admin token for admin endpoints (dashboard / CLI admin routes)
ADMIN_TOKEN=change-me-to-a-random-string

# OPTIONAL - Logging level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# ----------------------------------------
# Database (PostgreSQL)
# ----------------------------------------

# REQUIRED - Full async DSN used by orchestrator_service (asyncpg dialect)
# postgres:// and postgresql:// prefixes are auto-corrected to postgresql+asyncpg://
POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/platform

# REQUIRED - Used by the docker-compose postgres service
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platform
POSTGRES_PORT=5432

# OPTIONAL - Used by debug/diagnostic scripts
POSTGRES_HOST=localhost

# OPTIONAL - Legacy alias; some migration scripts fall back to DATABASE_URL
DATABASE_URL=

# OPTIONAL - Connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ----------------------------------------
# Redis
# ----------------------------------------

# REQUIRED
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------
# Supabase (Vector / RAG)
# ----------------------------------------

# REQUIRED
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ----------------------------------------
# OpenAI
# ----------------------------------------

# REQUIRED - Global fallback key; individual tenants can override via the UI
OPENAI_API_KEY=sk-...

# ----------------------------------------
# Google AI
# ----------------------------------------

# OPTIONAL - Google Gemini API key; fallback if OpenAI is not configured
GOOGLE_API_KEY=

# ----------------------------------------
# Google OAuth
# ----------------------------------------

# OPTIONAL - Required for the Google Sign-In button in the frontend
GOOGLE_OAUTH_CLIENT_ID=

# ----------------------------------------
# Stripe (Billing)
# ----------------------------------------

# REQUIRED for billing features
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----------------------------------------
# MercadoPago (Billing - LATAM)
# ----------------------------------------

# REQUIRED for MercadoPago billing
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=

# ----------------------------------------
# Meta / Facebook
# ----------------------------------------

# REQUIRED - App secret for webhook signature verification
META_APP_SECRET=

# REQUIRED - Verification token used when registering the Meta webhook
META_VERIFY_TOKEN=change-me-to-a-random-string

# OPTIONAL - Meta App ID (used by meta_service for OAuth token exchange)
META_APP_ID=

# OPTIONAL - Fallback redirect URI for Meta OAuth (overrides auto-detected URI)
META_REDIRECT_URI=

# OPTIONAL - Meta Graph API version (defaults to v22.0)
META_GRAPH_API_VERSION=v22.0

# ----------------------------------------
# WhatsApp / YCloud
# ----------------------------------------

# REQUIRED for WhatsApp messaging via YCloud
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=

# OPTIONAL - Default bot WhatsApp number in E.164 format (e.g. +5491123456789)
BOT_PHONE_NUMBER=

# ----------------------------------------
# Chatwoot (CRM Integration - Optional)
# ----------------------------------------

# OPTIONAL - Required only if Chatwoot integration is enabled per tenant
CHATWOOT_BASE_URL=
CHATWOOT_BOT_TOKEN=

# ----------------------------------------
# TiendaNube Integration
# ----------------------------------------

# OPTIONAL - Global fallback store credentials; tenants normally set these via the UI
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_API_KEY=

# OPTIONAL - TiendaNube OAuth app credentials; required for the OAuth install flow
TN_CLIENT_ID=
TN_CLIENT_SECRET=
TN_REDIRECT_URI=

# OPTIONAL - Encryption key for OAuth state parameter (generate a random string)
STATE_ENCRYPTION_KEY=change-me-generate-random-string

# ----------------------------------------
# Inter-Service URLs
# ----------------------------------------
# Default to docker-compose service names; override for EasyPanel or custom deployments.

# OPTIONAL - Orchestrator URL (used by agent, whatsapp, meta, tiendanube services)
ORCHESTRATOR_URL=http://orchestrator_service:8000

# OPTIONAL - Agent service URL (used by orchestrator)
AGENT_SERVICE_URL=http://agent_service:8001

# OPTIONAL - WhatsApp service URL (used by orchestrator)
WHATSAPP_SERVICE_URL=http://whatsapp_service:8002

# OPTIONAL - TiendaNube service URL (used by orchestrator)
TIENDANUBE_SERVICE_URL=http://tiendanube_service:8003

# OPTIONAL - Meta service URL (used by orchestrator admin routes)
META_SERVICE_URL=http://meta_service:8000

# ----------------------------------------
# CORS
# ----------------------------------------

# REQUIRED in production - comma-separated list of allowed origins
# Accepts JSON array or comma-separated string: "https://app.com,https://www.app.com"
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000

# OPTIONAL - Legacy alias read by orchestrator/main.py as a fallback
ALLOWED_ORIGINS=

# ----------------------------------------
# Frontend URL (for email links and OAuth redirects)
# ----------------------------------------

# REQUIRED in production
FRONTEND_URL=https://yourdomain.com

# ----------------------------------------
# Email / SMTP
# ----------------------------------------

# OPTIONAL - Required if email features are used (trial alerts, handoff notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=

# OPTIONAL - Sender identity displayed in outgoing emails
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=Future Platform

# OPTIONAL - Alias for SENDER_EMAIL used by some modules
EMAILS_FROM_EMAIL=

# OPTIONAL - Default handoff notification recipient when no tenant email is configured
DEFAULT_HANDOFF_EMAIL=admin@example.com

# ----------------------------------------
# Store Branding Defaults
# ----------------------------------------
# Global fallbacks; tenants normally configure these via the UI.

# OPTIONAL
STORE_NAME=
STORE_LOCATION=
STORE_WEBSITE=
STORE_DESCRIPTION=
STORE_CATALOG_KNOWLEDGE=

# OPTIONAL - Aliases read by orchestrator/main.py and app/core/init_data.py
GLOBAL_STORE_DESCRIPTION=
GLOBAL_CATALOG_KNOWLEDGE=
GLOBAL_SYSTEM_PROMPT=
SYSTEM_PROMPT=

# ----------------------------------------
# Feature Flags
# ----------------------------------------

# OPTIONAL - Enable Nexus v3 multi-tenant engine (defaults to true)
NEXUS_V3_ENABLED=true

# OPTIONAL - Background sync interval for TiendaNube orders (minutes, defaults to 10)
ORDERS_SYNC_INTERVAL_MINUTES=10

# ----------------------------------------
# Sales Attribution
# ----------------------------------------

# OPTIONAL - Attribution window for revenue tracking (hours, defaults to 168 = 7 days)
ATTRIBUTION_WINDOW_HOURS=168

# OPTIONAL - Email attribution window (hours, defaults to 48)
ATTRIBUTION_EMAIL_WINDOW_HOURS=48

# OPTIONAL - UTM source tag appended to attributed links
UTM_SOURCE_TAG=nexus_ai

# ----------------------------------------
# NVIDIA Riva / Voice Widget
# ----------------------------------------

# OPTIONAL - Required only if the voice widget with Riva NIM is enabled
RIVA_NIM_ENDPOINT=grpc.nvcf.nvidia.com:443

# ----------------------------------------
# Admin / Migrations
# ----------------------------------------

# OPTIONAL - Super admin email used by bootstrap migration scripts
SUPER_ADMIN_EMAIL=

# ----------------------------------------
# BFF Service
# ----------------------------------------

# OPTIONAL - BFF server port (defaults to 3000)
PORT=3000

# ----------------------------------------
# Frontend (VITE_* - build-time only, injected at Docker build or Vite dev server)
# ----------------------------------------

# REQUIRED - Base URL the frontend uses to reach the API/orchestrator
VITE_API_BASE_URL=http://localhost:8000

# OPTIONAL
VITE_TIENDANUBE_SERVICE_URL=
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_API_VERSION=v22.0
VITE_META_CONFIG_ID=
VITE_META_EMBEDDED_SIGNUP=false
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_DEFAULT_TENANT_ID=1
