# ==============================================================================
# Platform AI Solutions — Production Environment Template
# ==============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo a .env
# 2. Completar TODOS los campos marcados [REQUIRED]
# 3. Generar secrets con los comandos incluidos
# 4. NUNCA commitear .env — solo este template
# ==============================================================================

# ==============================================================================
# CRITICAL: Boot Requirements
# ==============================================================================

# REQUIRED - Set to "production" to enforce secret validation at startup
ENVIRONMENT=production

# Database
# REQUIRED - Full async DSN (postgresql+asyncpg://user:pass@host:5432/dbname)
# Generate: python -c "import secrets; print('postgresql+asyncpg://user:' + secrets.token_hex(16) + '@localhost:5432/platform')"
POSTGRES_DSN=

# Security
# REQUIRED - Secret key for JWT signing (min 32 chars)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# REQUIRED - Fernet encryption key for credential encryption at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# REQUIRED - Internal API token for service-to-service authentication
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_TOKEN=

# REQUIRED - Admin token for admin endpoints (dashboard / CLI admin routes)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# ==============================================================================
# INFRASTRUCTURE
# ==============================================================================

# REQUIRED - Redis connection URL
REDIS_URL=redis://redis:6379/0

# Service URLs (defaults for Docker Compose)
ORCHESTRATOR_SERVICE_URL=http://orchestrator_service:8000
AGENT_SERVICE_URL=http://agent_service:8001
WHATSAPP_SERVICE_URL=http://whatsapp_service:8002

# ==============================================================================
# AI
# ==============================================================================

# REQUIRED - OpenAI API key (sk-...)
OPENAI_API_KEY=

# OPTIONAL - Google AI API key
GOOGLE_API_KEY=

# ==============================================================================
# SUPABASE
# ==============================================================================

# REQUIRED - Supabase project URL
SUPABASE_URL=

# REQUIRED - Supabase service role key
SUPABASE_SERVICE_KEY=

# REQUIRED - Direct DB connection for pgvector
# Generate: python -c "import secrets; print('postgresql://postgres:' + secrets.token_hex(16) + '@db.your-project.supabase.co:5432/postgres')"
SUPABASE_DB_URL=

# ==============================================================================
# PAYMENTS
# ==============================================================================

# REQUIRED - Stripe secret key (sk_live_...)
STRIPE_SECRET_KEY=

# REQUIRED - Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# REQUIRED - MercadoPago access token
MP_ACCESS_TOKEN=

# REQUIRED - MercadoPago webhook secret
MP_WEBHOOK_SECRET=

# ==============================================================================
# GOOGLE OAUTH
# ==============================================================================

# OPTIONAL - For Google Sign-In button in the frontend
GOOGLE_OAUTH_CLIENT_ID=

# ==============================================================================
# CORS
# ==============================================================================

# REQUIRED - Comma-separated list of allowed origins in production
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==============================================================================
# LOGGING
# ==============================================================================

# OPTIONAL - Logging level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# OPTIONAL - Set to true ONLY for development (enables Swagger UI at /docs)
# WARNING: Never enable in production!
DEBUG=false

# ==============================================================================
# DATABASE POOL
# ==============================================================================

# OPTIONAL - Database connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# EMAIL (SMTP)
# ==============================================================================

# OPTIONAL - SMTP configuration for transactional emails
# SMTP_HOST: e.g. smtp.gmail.com, smtp.sendgrid.net
SMTP_HOST=
# SMTP_PORT: typically 587 (TLS) or 465 (SSL)
SMTP_PORT=
# SMTP_USER: your SMTP username
SMTP_USER=
# SMTP_PASSWORD: your SMTP password
SMTP_PASSWORD=
# SENDER_EMAIL: sender address for outgoing emails
SMTP_FROM_EMAIL=